ats(%w{James Edward Gray II})\n#   puts\n#   puts s.stats([1, 2, 3, nil, 4, 5, 1, 2])\n#\n# Prints:\n#\n#   Elements:  4\n#    Non-Nil:  4\n#     Unique:  4\n#\n#   Elements:  8\n#    Non-Nil:  7\n#     Unique:  6\n#',superclass:"Delegator",includes:[],prepends:[],extends:[],methods:{__getobj__:[{file:"stdlib/delegate.rb",range:{start:{line:331,character:6},end:{line:331,character:16}},full_range:{start:{line:331,character:2},end:{line:337,character:5}},comments:"  # Returns the current object method calls are being delegated to.",parameters:"()",module:"SimpleDelegator"}],__setobj__:[{file:"stdlib/delegate.rb",range:{start:{line:353,character:6},end:{line:353,character:16}},full_range:{start:{line:353,character:2},end:{line:356,character:5}},comments:"  #\n  # Changes the delegate object to _obj_.\n  #\n  # It's important to note that this does *not* cause SimpleDelegator's methods\n  # to change.  Because of this, you probably only want to change delegation\n  # to objects of the same type as the original delegate.\n  #\n  # Here's an example of changing the delegation object.\n  #\n  #   names = SimpleDelegator.new(%w{James Edward Gray II})\n  #   puts names[1]    # => Edward\n  #   names.__setobj__(%w{Gavin Sinclair})\n  #   puts names[1]    # => Sinclair\n  #",parameters:"(obj)",module:"SimpleDelegator"}]},singleton_methods:{}}],Digest:[{name:"Digest",kind:"module",file:"stdlib/digest.rb",range:{start:{line:10,character:0},end:{line:285,character:3}},name_range:{start:{line:10,character:7},end:{line:10,character:13}},comments:"# The digest classes wrap node:crypto's createHash, so the algorithms available\n# are the ones that module offers, and a platform without a crypto module (a\n# browser, say) raises NotImplementedError rather than answering with a wrong\n# digest.",superclass:null,includes:[],prepends:[],extends:[],methods:{},singleton_methods:{hexencode:[{file:"stdlib/digest.rb",range:{start:{line:15,character:11},end:{line:15,character:20}},full_range:{