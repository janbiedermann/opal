#!/usr/bin/env node
// Sorts and deduplicates the `fails` lines of every filter group in
// spec/filters/**/*.rb.
import("node:fs").then(async (fs) => {
  const { glob } = await import("../tasks/testing/glob.mjs");
  process.chdir(new URL("..", import.meta.url).pathname);

  // like Ruby's Array#sort (byte order) then #uniq by the spec name
  const byteCompare = (a, b) => Buffer.compare(Buffer.from(a), Buffer.from(b));
  const sortLines = (lines) => {
    const seen = new Set();
    return [...lines].sort(byteCompare).filter((l) => {
      const key = l.split('" # ')[0];
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  };

  const groupLines = (lines) => {
    const groups = [];
    let group = null;
    for (const line of lines) {
      const m = /^(opal_(?:unsupported_)?filter) *"([^"]+)" *do *\n/.exec(line);
      if (m) {
        if (group) throw new Error(`bad group for ${JSON.stringify(line)}!`);
        group = { type: m[1], title: m[2], lines: [] };
      } else if (/^ {2}fails/.test(line)) {
        group.lines.push(line);
      } else if (/^end/.test(line)) {
        groups.push(group);
        group = null;
      }
    }
    return groups;
  };

  const writeGroups = (groups) => "# NOTE: run bin/format-filters after changing this file\n" + groups.map((group, index) => {
    console.log(`- ${group.type} ${JSON.stringify(group.title)}...`);
    return (index > 0 ? "\n" : "") + `${group.type} "${group.title}" do\n` + sortLines(group.lines).join("") + "end\n";
  }).join("");

  for (const path of glob("spec/filters/**/*.rb")) {
    console.log(`\nFormatting ${path} ...`);
    const lines = fs.readFileSync(path, "utf8").split(/(?<=\n)/);
    fs.writeFileSync(path, writeGroups(groupLines(lines)));
  }
});
