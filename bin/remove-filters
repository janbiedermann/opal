#!/usr/bin/env node
// Removes the filters given on standard input from spec/filters/**/*.rb.
//
// This is to assist with removing a large group of filters spread around
// multiple files, as output by:
//
//   node tasks/test.mjs mspec_ruby   # with RUBYSPECS=true INVERT_RUNNING_MODE=true
//
// It expects an input of format:
//  1) "Set#filter! returns an Enumerator when passed no block"
//  2) "Set#filter! yields every element of self"
// (or `fails "..."` lines). In the output of an inverted run, only the
// list after "Expected N examples to fail:" counts (with a PATTERN the
// output also has the report of the examples that still fail, with their
// `fails "..."` lines).
import("node:fs").then(async (fs) => {
  const { glob } = await import("../tasks/testing/glob.mjs");
  process.chdir(new URL("..", import.meta.url).pathname);

  let lines = fs.readFileSync(0, "utf8").replace(/\x1b\[[0-9;]*m/g, "").split("\n");
  const list = lines.findIndex((line) => /^Expected \d+ examples to fail/.test(line));
  if (list !== -1) lines = lines.slice(list + 1);
  const filters = lines
    .map((line) => (list !== -1 ? /^\s*\d+\) (".*")/ : /(?:\d+\)|fails) (".*")/).exec(line))
    .filter(Boolean)
    .map((m) => m[1]);
  if (filters.length === 0) return;

  for (const path of glob("spec/filters/**/*.rb")) {
    const lines = fs.readFileSync(path, "utf8").split("\n");
    const good = lines.filter((line) => !filters.some((f) => line.includes(f)));
    if (good.length !== lines.length) {
      console.log(`Removing ${lines.length - good.length} filters from ${path}`);
      fs.writeFileSync(path, good.join("\n").replace(/\n*$/, "") + "\n");
    }
  }
});
