#!/bin/sh
# Runs yarn in the project root.
cd "$(dirname "$0")/.." || exit 1
if command -v yarnpkg >/dev/null 2>&1; then
  exec yarnpkg "$@"
elif command -v yarn >/dev/null 2>&1; then
  exec yarn "$@"
fi
echo "Yarn executable was not detected in the system." >&2
echo "Download Yarn at https://yarnpkg.com/en/docs/install" >&2
exit 1
