#!/usr/bin/env node
// Installs the git submodules from GitHub zip archives of their commits
// (faster than cloning, e.g. on CI), then runs `git submodule init`.
const { execSync, execFileSync } = require("node:child_process");
const { existsSync, mkdirSync, rmSync, readdirSync, renameSync } = require("node:fs");
const { dirname, join } = require("node:path");

const run = (cmd, args) => {
  console.log(`== command: ${[cmd, ...args].join(" ")}`);
  execFileSync(cmd, args, { stdio: "inherit" });
};

process.chdir(join(__dirname, ".."));
mkdirSync("tmp", { recursive: true });
try {
  execSync("git submodule --quiet deinit --all -f", { stdio: "ignore" });
} catch {
  // nothing to deinit
}

const modules = {};
for (const line of execSync("git config -f .gitmodules --list", { encoding: "utf8" }).split("\n").filter(Boolean)) {
  const [fullkey, value] = [line.slice(0, line.indexOf("=")), line.slice(line.indexOf("=") + 1)];
  const [, name, key] = fullkey.match(/^submodule\.(.+)\.([^.]+)$/);
  (modules[name] ||= {})[key] = value.trim();
}
for (const line of execSync("git submodule", { encoding: "utf8" }).split("\n").filter(Boolean)) {
  const [, sha1, name] = line.slice(1).match(/^(\w+) (\S+)/);
  modules[name].sha1 = sha1;
}

for (const [name, { url, sha1, path }] of Object.entries(modules)) {
  console.log(`== installing ${name}...`);
  const dir = dirname(path);
  const zip = `tmp/${sha1}.zip`;
  run("curl", ["-L", `${url.replace(/\.git$/, "")}/archive/${sha1}.zip`, "-o", zip]);
  run("unzip", ["-q", zip, "-d", dir]);
  rmSync(zip);
  if (existsSync(path)) rmSync(path, { recursive: true, force: true });
  const extracted = readdirSync(dir).find((e) => e.endsWith(`-${sha1}`));
  renameSync(join(dir, extracted), path);
  console.log(`== completed installing ${name}.`);
}

run("git", ["submodule", "init"]);
