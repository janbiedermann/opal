#!/bin/sh
# Runs a benchmark-ips benchmark (needs BENCHMARK_IPS_LIB, see tasks/bench.mjs):
#   bin/opal-benchmark-ips benchmark-ips/bm_case.rb
if [ $# -ne 1 ]; then
  echo "usage example:" >&2
  echo "" >&2
  echo "  $0 benchmark-ips/bm_case.rb" >&2
  exit 1
fi
exec node "$(dirname "$0")/../tasks/bench.mjs" ips "$1"
